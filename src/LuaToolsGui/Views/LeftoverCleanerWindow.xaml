<Window x:Class="LuaToolsGui.Views.LeftoverCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Steam Leftover Cleaner" Height="500" Width="600" MinWidth="550" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1c1c22" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="🧹 Leftover Cleaner" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Foreground="#9ca3af" FontSize="13">
                    <Run Text="Mencari sisa Mod, Config, dan Save untuk "/>
                    <Run Text="{Binding GameName}" FontWeight="Bold" Foreground="#8b5cf6"/>
                </TextBlock>
            </StackPanel>
            
            <ui:ProgressRing Grid.Column="1" IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Foreground="#8b5cf6" Width="24" Height="24"/>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#16a34a" FontSize="13" Margin="0,0,0,10" FontWeight="SemiBold"/>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <ItemsControl ItemsSource="{Binding Leftovers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kotak Kartu -->
                        <Border Background="#11ffffff" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                    </CheckBox.LayoutTransform>
                                </CheckBox>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Description}" FontSize="15" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                
                                <!-- Ukuran -->
                                <Border Grid.Column="2" Background="#2a2a35" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeString}" FontWeight="Bold" FontSize="12" Foreground="#f87171"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Delete Button -->
        <Button Grid.Row="3" 
                Command="{Binding DeleteSelectedCommand}"
                Content="🗑️ HAPUS YANG DICENTANG"
                Background="#ef4444" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,10" HorizontalAlignment="Right" />
    </Grid>
</Window>
