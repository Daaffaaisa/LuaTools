<UserControl
    x:Class="LuaToolsGui.Views.SteamLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    d:DataContext="{d:DesignInstance Type=vm:SteamLibraryViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid x:Name="Root" Margin="8,16,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="Bold" Text="Steam Library" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#9ca3af" Text="Official Steam games installed on this PC. Manage DLCs, mods, achievements, and storage." />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding ScanLibraryCommand}"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!-- Search + Filter Pills -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Search installed games by title or AppID..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Filter Pills -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button
                    Margin="0,0,6,0"
                    Padding="12,6"
                    BorderThickness="1"
                    Cursor="Hand"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#14ffffff" />
                            <Setter Property="BorderBrush" Value="#22ffffff" />
                            <Setter Property="Foreground" Value="#d1d5db" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                    <Setter Property="Background" Value="#8b5cf6" />
                                    <Setter Property="BorderBrush" Value="#a78bfa" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All Installed" FontWeight="SemiBold" FontSize="12.5" />
                        <Border Margin="6,0,0,0" Padding="5,1" Background="#22000000" CornerRadius="10">
                            <TextBlock Text="{Binding TotalGamesCount}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button
                    Margin="0,0,6,0"
                    Padding="12,6"
                    BorderThickness="1"
                    Cursor="Hand"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="Injected">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#14ffffff" />
                            <Setter Property="BorderBrush" Value="#22ffffff" />
                            <Setter Property="Foreground" Value="#d1d5db" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterInjected}" Value="True">
                                    <Setter Property="Background" Value="#8b5cf6" />
                                    <Setter Property="BorderBrush" Value="#a78bfa" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DLCs Injected" FontWeight="SemiBold" FontSize="12.5" />
                        <Border Margin="6,0,0,0" Padding="5,1" Background="#22000000" CornerRadius="10">
                            <TextBlock Text="{Binding InjectedCount}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button
                    Padding="12,6"
                    BorderThickness="1"
                    Cursor="Hand"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="Vanilla">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#14ffffff" />
                            <Setter Property="BorderBrush" Value="#22ffffff" />
                            <Setter Property="Foreground" Value="#d1d5db" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterVanilla}" Value="True">
                                    <Setter Property="Background" Value="#3b82f6" />
                                    <Setter Property="BorderBrush" Value="#60a5fa" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Vanilla" FontWeight="SemiBold" FontSize="12.5" />
                        <Border Margin="6,0,0,0" Padding="5,1" Background="#22000000" CornerRadius="10">
                            <TextBlock Text="{Binding VanillaCount}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Games Grid -->
        <vwp:VirtualizingItemsControl
            x:Name="TileScroller"
            Grid.Row="2"
            Margin="0,14,0,0"
            Focusable="False"
            ItemsSource="{Binding FilteredGames}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <vwp:VirtualizingItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel
                        Orientation="Horizontal"
                        SpacingMode="StartAndEndOnly"
                        StretchItems="False" />
                </ItemsPanelTemplate>
            </vwp:VirtualizingItemsControl.ItemsPanel>
            <vwp:VirtualizingItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SteamLibraryItemVm}">
                    <Border
                        x:Name="TileRoot"
                        Width="248"
                        Margin="6"
                        Background="#13141b"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonUp="Tile_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1c1d28" />
                                        <Setter Property="BorderBrush" Value="#44FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <!-- Cover Art with Status Badge -->
                            <Border
                                Height="116"
                                Background="#11FFFFFF"
                                CornerRadius="10,10,0,0"
                                ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />

                                    <!-- Status Badge (Top-Right) -->
                                    <Border
                                        Margin="0,6,6,0"
                                        Padding="6,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{Binding StatusBadgeBackground}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding StatusBadge}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Info -->
                            <StackPanel Margin="12,10,12,12">
                                <TextBlock
                                    Height="36"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="#6b7280"
                                        Text="{Binding AppId, StringFormat=AppID: {0}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11.5"
                                        Foreground="#9ca3af"
                                        Text="{Binding FormattedSize}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </vwp:VirtualizingItemsControl.ItemTemplate>
        </vwp:VirtualizingItemsControl>

        <!-- Loading State -->
        <StackPanel
            Grid.Row="2"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#9ca3af"
                Text="Scanning installed Steam games..." />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel
            Grid.Row="2"
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding FilteredGames.Count}" Value="0" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="#4b5563"
                Symbol="Library24" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="#9ca3af"
                Text="No installed Steam games found matching your filter."
                TextAlignment="Center" />
        </StackPanel>

        <!-- Detail Flyout: Dim Scrim + Slide-in Panel from the Right -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="-8,-16,-16,-8"
            Background="#80000000"
            Visibility="{Binding IsFlyoutOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim click to dismiss -->
            <Border Background="Transparent" MouseLeftButtonUp="Scrim_Click" />

            <!-- Panel -->
            <Border
                Width="380"
                HorizontalAlignment="Right"
                Background="#1c1c22"
                BorderBrush="#22FFFFFF"
                BorderThickness="1,0,0,0">
                <Grid Margin="20" DataContext="{Binding SelectedGame}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Close Button -->
                    <ui:Button
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Command="{Binding DataContext.CloseFlyoutCommand, ElementName=Root}"
                        Icon="{ui:SymbolIcon Dismiss24}" />

                    <!-- Cover + Title -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Border
                            Height="170"
                            Background="#11FFFFFF"
                            ClipToBounds="True"
                            CornerRadius="10">
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border
                                Margin="0,0,6,0"
                                Padding="6,2"
                                Background="{Binding StatusBadgeBackground}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding StatusBadge}" />
                            </Border>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="Copy AppID">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#9ca3af"
                                        VerticalAlignment="Center"
                                        Text="{Binding AppId, StringFormat=AppID: {0}}" />
                                    <ui:SymbolIcon
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#6b7280"
                                        Symbol="Copy24" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11.5"
                            Foreground="#6b7280"
                            Text="{Binding InstallDir}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding InstallDir}" />
                    </StackPanel>

                    <!-- Scrollable Action List -->
                    <ScrollViewer
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,16">
                            <!-- DLC Actions -->
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#d1d5db"
                                Text="DLC Actions" />

                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding DataContext.UnlockAllDlcsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Unlock All DLCs (1-Click)"
                                Icon="{ui:SymbolIcon Sparkle24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.CustomizeDlcsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Customize DLCs..."
                                Icon="{ui:SymbolIcon CheckboxChecked24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Appearance="Danger"
                                Command="{Binding DataContext.RemoveDlcsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Remove Injected DLCs"
                                Icon="{ui:SymbolIcon Delete24}"
                                Visibility="{Binding IsDlcInjected, Converter={StaticResource BoolToVis}}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.NavigateBuildsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Open in Builds"
                                Icon="{ui:SymbolIcon BranchFork24}" />

                            <!-- Tools & Management -->
                            <TextBlock
                                Margin="0,18,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#d1d5db"
                                Text="Tools &amp; Management" />

                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.EditLaunchOptionsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Edit Launch Options"
                                Icon="{ui:SymbolIcon Play24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.ManageAchievementsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Manage Achievements"
                                Icon="{ui:SymbolIcon Trophy24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.ManageModsCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Manage Mods"
                                Icon="{ui:SymbolIcon Settings24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.MoveStorageCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Move Storage (Symlink)"
                                Icon="{ui:SymbolIcon FolderArrowRight24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.CleanLeftoversCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Clean Leftover Files"
                                Foreground="#f87171"
                                Icon="{ui:SymbolIcon Delete24}" />

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.RemoveDrmCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Content="Remove DRM (Steamless)"
                                Icon="{ui:SymbolIcon WrenchScrewdriver24}" />

                            <!-- Quick Links -->
                            <TextBlock
                                Margin="0,18,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#d1d5db"
                                Text="Quick Links" />

                            <UniformGrid Columns="2" Rows="2">
                                <ui:Button
                                    Margin="0,0,4,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenStorePageCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Open Store"
                                    Icon="{ui:SymbolIcon Globe24}" />
                                <ui:Button
                                    Margin="4,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenInSteamCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="In Steam"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <ui:Button
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.RevealFolderCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Reveal Folder"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                                <ui:Button
                                    Margin="4,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Copy AppID"
                                    Icon="{ui:SymbolIcon Copy24}" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
