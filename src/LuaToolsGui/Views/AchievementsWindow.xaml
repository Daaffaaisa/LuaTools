<Window x:Class="LuaToolsGui.Views.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding GameTitle}" Height="600" Width="800" MinWidth="750" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#1c1c22" Foreground="White">

        <!-- Area Aturan (Data Trigger) -->
        <Window.Resources>
            <!-- Aturan untuk layar utama (Sembuni kalau IsIdling = True)-->
            <Style TargetType="Grid" x:Key="MainGridStyle">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIdling}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        <!-- Aturan untuk layar Idle (Muncul kalau IsIdling = True)-->
        <Style TargetType="Grid" x:Key="IdleGridStyle">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIdling}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Window.Resources>

    <Grid Margin="20">
        <Grid Style="{StaticResource MainGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/> 
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Judul -->
            <TextBlock Grid.Row="0" Text="{Binding GameTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <!-- 2. Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <Grid>
                    <TextBlock Text="Progress" FontWeight="SemiBold" Foreground="#d1d5db"/>
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" Foreground="#d1d5db" FontWeight="Bold"/>
                </Grid>
                <!-- Progress Bar warna hijau ala Steam -->
                <ProgressBar Maximum="{Binding TotalAchievements}" Value="{Binding UnlockedAchievements}" Height="12" Margin="0,5,0,0" Foreground="#16a34a" Background="#2a2a35" BorderThickness="0"/>
            </StackPanel>

            <!-- New Search Bar-->

            <Border Grid.Row="2" Margin="0,0,0,15" Background="#2a2a35" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ikon Kaca Pembesar -->
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Teks Placeholder (Muncul kalau teks kosong) -->
                    <TextBlock Grid.Column="1" Text="Search achievement (name or description)..." 
                               Foreground="#6b7280" FontSize="14" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- TextBox Asli (Transparan) ditumpuk di atas Placeholder -->
                    <TextBox x:Name="SearchInput" Grid.Column="1" 
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" VerticalContentAlignment="Center" CaretBrush="White"/>
                </Grid>
            </Border>

            <!-- 3. Daftar Achievement (Sistem Kartu) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AchievementsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Kotak Kartu -->
                            <Border Background="#11ffffff" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Gambar Ikon -->
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,15,0" Stretch="UniformToFill"/>

                                    <!-- Teks Nama & Deskripsi -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Checkbox (Diperbesar) -->
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsUnlocked}" VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>    
            
            <Button Grid.Column="0" Padding="12"
                    Command="{Binding UnlockAllCommand}" 
                    Content="🔓 Unlock All Achievements"
                    Background="#8b5cf6" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

            <Button Grid.Column="2" Padding="12"
                    Command="{Binding LockAllCommand}" 
                    Content="🔒 Lock All Achievements"
                    Background="#6b7280" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <!-- 5. Tombol Toggle Idle -->

            <!-- 4. Tombol Save -->
            <Button Grid.Column="4" Padding="12"
                    Command="{Binding SaveChangesCommand}"
                    Content="💾 Save Changes to Steam"
                    Background="#16a34a" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <!-- 5. Tombol Toggle Idle -->
            <Button Grid.Column="6" Padding="12,12,12,12"
                    Command="{Binding ToggleIdleCommand}"
                    Content="💤 Idle Mode"
                    Background="#3b82f6" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        <!-- PENUTUP MAIN GRID STYLE (Tadi ketinggalan di sini) -->
        </Grid>

        <Grid Style="{StaticResource IdleGridStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="😴" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Farming Playtime..." FontSize="24" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding GameTitle}" FontSize="14" Foreground="#d1d5db" HorizontalAlignment="Center" Margin="0,10,0,30" TextAlignment="Center"/>
                <TextBlock Text = "{Binding IdleTimeText}" FontSize="36" FontWeight="Heavy" Foreground="#10b981" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                <!-- Tombol kembali yang akan merubak IsIdling menjadi false lagi-->
                <Button Padding="20,12" Command="{Binding ToggleIdleCommand}" Content="⏹️ Stop Idling &amp; Kembali" Background="#ef4444" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>