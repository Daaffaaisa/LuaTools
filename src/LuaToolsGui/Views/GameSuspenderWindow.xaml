<Window x:Class="LuaToolsGui.Views.GameSuspenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Task Freezer" Height="600" Width="600" MinWidth="550" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#1c1c22" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="❄️ Console-Style Game Suspender" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Bekukan memori game ke 0% CPU secara paksa." Foreground="#9ca3af" FontSize="13"/>
            </StackPanel>
            
            <Button Grid.Column="1" Command="{Binding RefreshProcessesCommand}"
                    Content="🔄 Refresh"
                    Background="#2a2a35" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,8" VerticalAlignment="Center"/>
        </Grid>

        <!-- Warning Alert -->
        <Border Grid.Row="1" Background="#4f191b" BorderThickness="0" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="PERINGATAN KERAS!" FontWeight="Bold" Foreground="#f87171" FontSize="14"/>
                    <TextBlock Text="Hanya gunakan ini untuk Game Single-Player / Offline. Jika kamu membekukan Game Multiplayer/Online (Valorant, CS2), kamu akan langsung RTO dan DISCONNECT dari server!" Foreground="#fca5a5" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#16a34a" FontSize="13" Margin="0,0,0,10" FontWeight="SemiBold"/>

        <!-- List Processes -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kotak Kartu -->
                        <Border Background="#11ffffff" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Process Info -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#8b5cf6"/>
                                        <TextBlock Text=" • PID: " FontSize="12" Foreground="#9ca3af"/>
                                        <TextBlock Text="{Binding ProcessId}" FontSize="12" Foreground="#9ca3af"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Suspend Button -->
                                <Button Grid.Column="1" 
                                        Command="{Binding DataContext.ToggleSuspendCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Background="{Binding StatusColor}" CornerRadius="6" Padding="20,8" Width="100">
                                                <TextBlock x:Name="BtnText" Text="{Binding ButtonText}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
