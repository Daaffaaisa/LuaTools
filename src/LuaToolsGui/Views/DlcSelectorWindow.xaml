<ui:FluentWindow
    x:Class="LuaToolsGui.Views.DlcSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    Title="Select DLCs"
    Width="760"
    Height="600"
    d:DataContext="{d:DesignInstance Type=vm:DlcSelectorViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Select DLCs" />

        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding GameName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="#9ca3af"
                    Text="{Binding AppId, StringFormat='App ID: {0}'}" />
            </StackPanel>

            <!-- Search and Bulk Action Controls -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search DLC name or AppID..."
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="0,0,6,0"
                    Command="{Binding SelectAllCommand}"
                    Content="Select Game DLCs"
                    ToolTip="Select all game DLCs (excludes Soundtracks and Bonuses)" />

                <ui:Button
                    Grid.Column="2"
                    Margin="0,0,6,0"
                    Command="{Binding SelectEverythingCommand}"
                    Content="Select All (Incl. Extras)"
                    ToolTip="Select all items including Soundtracks and Artbooks" />

                <ui:Button
                    Grid.Column="3"
                    Command="{Binding DeselectAllCommand}"
                    Content="Deselect All" />
            </Grid>

            <!-- DLC Items List -->
            <Border
                Grid.Row="2"
                Background="#0affffff"
                BorderBrush="#14ffffff"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,2"
                                    Padding="10,8"
                                    Background="#08ffffff"
                                    BorderBrush="#0fffffff"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected}" />

                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!-- Soundtrack Tag -->
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="#263b82f6"
                                                    BorderBrush="#403b82f6"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding IsSoundtrack, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#60a5fa"
                                                        Text="SOUNDTRACK" />
                                                </Border>

                                                <!-- Bonus / Artbook Tag -->
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="#26f59e0b"
                                                    BorderBrush="#40f59e0b"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding IsBonus, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#fbbf24"
                                                        Text="BONUS" />
                                                </Border>

                                                <!-- Regular Game DLC Tag -->
                                                <Border
                                                    Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Background="#2a2440"
                                                    CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSoundtrack}" Value="False" />
                                                                        <Condition Binding="{Binding IsBonus}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#c4b5fd"
                                                        Text="DLC" />
                                                </Border>
                                            </StackPanel>

                                            <!-- File Status Pill & Meta -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- License Only Pill -->
                                                <Border
                                                    Padding="6,1"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Background="#1510b981"
                                                    BorderBrush="#3010b981"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Visibility="{Binding HasDepot, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#34d399"
                                                        Text="License Only" />
                                                </Border>

                                                <!-- Files Required Pill -->
                                                <Border
                                                    Padding="6,1"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Background="#1506b6d4"
                                                    BorderBrush="#3006b6d4"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Visibility="{Binding HasDepot, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#22d3ee"
                                                        Text="{Binding Meta}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#6b7280"
                                            Text="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Bottom Action Footer -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#9ca3af">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} of {1} DLCs selected">
                            <Binding Path="SelectedCount" />
                            <Binding Path="TotalCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <ui:Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />

                <ui:Button
                    Grid.Column="2"
                    Appearance="Primary"
                    Command="{Binding ApplyCommand}"
                    Content="Add Selected DLCs"
                    Icon="{ui:SymbolIcon Add24}"
                    IsEnabled="{Binding HasSelection}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
