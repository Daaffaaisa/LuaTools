<Window x:Class="LuaToolsGui.Views.AccountSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ganti Akun Kilat" Height="500" Width="450" MinWidth="400" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#1c1c22" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🔄 Fast Account Switcher" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="0" Text="Pindah akun tanpa password, tanpa ribet." Foreground="#9ca3af" FontSize="13" Margin="0,25,0,15"/>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#16a34a" FontSize="13" Margin="0,0,0,15" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kotak Kartu -->
                        <Border Background="#11ffffff" CornerRadius="8" Padding="12" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Avatar Placeholder -->
                                <Border Width="40" Height="40" CornerRadius="20" Background="#2a2a35" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Teks -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding PersonaName}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="#9ca3af" Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <!-- Action Button -->
                                <Button Grid.Column="2" 
                                        Command="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Content="LOGIN"
                                        Background="#8b5cf6" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,8" VerticalAlignment="Center">
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
