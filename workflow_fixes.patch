-        foreach (string dir in Directory.GetDirectories(source, "*", SearchOption.AllDirectories))
-        {
-            Directory.CreateDirectory(dir.Replace(source, target));
-        }
-        
-        foreach (string file in files)
-        {
-            string dest = file.Replace(source, target);
